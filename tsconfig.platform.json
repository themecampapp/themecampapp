{
  "extends": "./tsconfig.json",
  "include": [
    "platform/.react-router/types/**/*",
    "platform/app/**/*",
    "platform/workers/**/*",
    "platform/worker-configuration.d.ts",
    "app/lib/hosts.ts",
    "app/lib/reserved-slugs.ts",
    "app/lib/markdown.server.ts",
    "app/lib/security-headers.ts",
    "app/lib/notify.server.ts",
    "app/lib/turnstile.server.ts",
    "app/lib/disclaimer.ts",
    "app/lib/legal.ts",
    "app/lib/instance-features.ts",
    "app/lib/icons.ts",
    "app/lib/version.ts",
    "package.json",
    "app/lib/email/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": ["./platform", "./platform/.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.platform.tsbuildinfo"
  }
}
